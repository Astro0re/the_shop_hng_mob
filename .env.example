EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
EXPO_PUBLIC_APP_SCHEME=the-shop-dev
EXPO_PUBLIC_API_URL=http://localhost:3001

# Replace these example identifiers before creating store builds.
EXPO_IOS_BUNDLE_ID=com.example.theshop
EXPO_ANDROID_PACKAGE=com.example.theshop

# Private API server configuration. Never prefix these with EXPO_PUBLIC_.
PORT=3001
APP_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Choose Brevo API or SMTP, with a verified sender address.
BREVO_API=your-brevo-api-key
BREVO_FROM=verified-sender@your-domain.com
# BREVO_SMTP_USER=your-brevo-smtp-login
# BREVO_SMTP_KEY=your-brevo-smtp-key

# Optional legacy Mailgun fallback.
# MAILGUN_API_KEY=your-mailgun-api-key
# MAILGUN_DOMAIN=your-mailgun-domain
# MAILGUN_FROM=The Shop <postmaster@your-mailgun-domain>
